# Google Cloud Configuration
PROJECT_ID=your-google-cloud-project-id
LOCATION=global
COLLECTION=default_collection
GE_APP_ID=your-alphaevolve-engine-id
ASSISTANT=default_assistant
BASE_URL=discoveryengine.googleapis.com

# LLM Model Mixture (Relative weights normalized server-side)
MODEL_1=gemini-3.5-flash
MODEL_1_WEIGHT=0.7
MODEL_2=gemini-3.1-pro-preview
MODEL_2_WEIGHT=0.3

# Multi-Objective NAS Targets & Constraints
# TARGET_PARAMS: Parameter budget ceiling (e.g. 50000 for edge-grade micro-architecture, 150000 for standard)
TARGET_PARAMS=50000
# TARGET_ACCURACY: Target validation accuracy threshold (e.g. 0.98 for 98%)
TARGET_ACCURACY=0.98
TOP_N_MODELS=3

# Search Budget & Concurrency (10 evaluations is optimal for live in-person training)
MAX_PROGRAMS_GENERATED=10
MAX_PROGRAMS_EVALUATED=10
CONCURRENCY=4
WORKER_CONCURRENCY=2
PARALLEL_EVALUATION=True
